# PC별 관제 설정 예시 (실습 PC 2026-11-12 기준). 관제 서버와 주차 판정 launch가 같이 읽습니다.
#   cp .control-station/control-station.env.example .control-station/control-station.env
#   set -a; source .control-station/control-station.env; set +a; ./run-control-station.sh
# control-station.env는 Git에서 제외됩니다. 다른 PC에서는 아래 장치 경로를 그 PC에 맞게 고칩니다.

# ROS: 주차 판정 노드와 관제가 같은 domain을 쓰고, 이 PC 안에서만 통신합니다.
ROS_DOMAIN_ID=87
ROS_AUTOMATIC_DISCOVERY_RANGE=LOCALHOST

# 카메라. HCAM0 두 대는 일련번호가 같아 USB 포트(by-path)로 구분합니다: ls -l /dev/v4l/by-path/
# 천장(탑) 캠은 주차 판정 launch(ceiling_parking.launch.py)가 열고, 관제는 그 토픽을 받습니다.
CONTROL_STATION_CEILING_CAMERA=/dev/v4l/by-path/pci-0000:80:14.0-usb-0:4:1.0-video-index0
CONTROL_STATION_HEAD_CAMERA=ros:/ceiling_camera/image_raw/compressed
CONTROL_STATION_SHELF_CAMERA=/dev/v4l/by-path/pci-0000:80:14.0-usb-0:10:1.0-video-index0
CONTROL_STATION_JOINT_CAMERA=/dev/v4l/by-id/usb-Innomaker_Innomaker-U20CAM-720P_SN0001-video-index0

# 핑키 주차 판정: .control-station/parking-spots/<spot_id>.json
CONTROL_STATION_PARKING_SPOT=pinky_dock_1

# YOLO: 인웅님 best19 (feat/yolo-object-detection b3fcbbe). scripts/check_setup.sh --vision이 받아 둡니다.
CONTROL_STATION_HEAD_YOLO_WEIGHTS=.control-station/models/best19_b3fcbbe.pt
CONTROL_STATION_SHELF_YOLO_WEIGHTS=.control-station/models/best19_b3fcbbe.pt
CONTROL_STATION_HEAD_YOLO_DEVICE=cpu
CONTROL_STATION_SHELF_YOLO_DEVICE=cpu

# 팔 2대 (docs/implementation/runbook.md "팔 2대 · 카메라 6대"). 팔마다 포트·그리퍼 캠·탑 캠을 따로 줍니다.
# arm-01 = 왼쪽 선반 앞 F58AE686, arm-02 = 오른쪽 선반 앞 A9F93543 (config/arms.json board_serial).
# 카메라 경로는 꽂은 USB 자리(by-path)로: ls -l /dev/v4l/by-path/  (아래 카메라 경로는 자리 예시라 실제와 다릅니다)
# CONTROL_STATION_ARM01_FOLLOWER_PORT=/dev/serial/by-id/usb-ROBOTIS_OpenRB-150_F58AE68650323952582E3120FF05260E-if00
# CONTROL_STATION_ARM01_GRIPPER_CAMERA=/dev/v4l/by-path/pci-0000:80:14.0-usb-0:<자리>:1.0-video-index0
# CONTROL_STATION_ARM01_OVERHEAD_CAMERA=/dev/v4l/by-path/pci-0000:80:14.0-usb-0:<자리>:1.0-video-index0
# CONTROL_STATION_ARM02_FOLLOWER_PORT=/dev/serial/by-id/usb-ROBOTIS_OpenRB-150_A9F9354350323952582E3120FF070727-if00
# CONTROL_STATION_ARM02_GRIPPER_CAMERA=/dev/v4l/by-path/pci-0000:80:14.0-usb-0:<자리>:1.0-video-index0
# CONTROL_STATION_ARM02_OVERHEAD_CAMERA=/dev/v4l/by-path/pci-0000:80:14.0-usb-0:<자리>:1.0-video-index0
# CONTROL_STATION_ARM01_ROBOT_ID=omx_follower_arm   LeRobot 보정 파일 이름 (팔마다 따로 보정했다면 다르게)
# 탑 캠도 관제 화면에 띄우려면(USB 대역을 더 씀): CONTROL_STATION_OVERHEAD_CAMERA_PREVIEW=1

# 팔 1대(예전 설정). 자세 파일은 follower 보드마다 따로입니다 (omx-poses-<보드 앞 8자리>.json).
CONTROL_STATION_FOLLOWER_PORT=/dev/serial/by-id/usb-ROBOTIS_OpenRB-150_A9F9354350323952582E3120FF070727-if00
CONTROL_STATION_OMX_POSES=.control-station/omx-poses-A9F93543.json
# 작업의 EXECUTE_ARM_TASK가 실제 팔 명령을 큐에 넣게 하려면 1. 팔이 연결된 PC에서만 켭니다.
# CONTROL_STATION_TASK_REAL_ARM=1

# 주문 흐름 (기본은 모의 세계)
# CONTROL_STATION_ORDER_COUNTS=camera                      선반 재고·핑키 위 개수를 카메라 YOLO로 셈
# CONTROL_STATION_PINKY_FLEET_URL=http://127.0.0.1:8765    핑키 관제(pinky_fleet_dashboard)와 연동
