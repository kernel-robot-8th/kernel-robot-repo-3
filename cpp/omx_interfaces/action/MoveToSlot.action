# Bring the OMX follower to the joint pose taught for one shelf slot. No grasping: a LeRobot-trained
# policy takes over from that pose. The goal carries no coordinates; the worker replays the recorded pose.

# Goal
string command_id                   # control-station command ID, kept for tracing
string slot_id                      # e.g. slot_a_2_1 (config/shelf-slots.json)
string slot_map_version             # SHA-256 of the slot map the goal was made with
builtin_interfaces/Time valid_until # the worker does not start after this time
---
# Result
string outcome                 # SUCCEEDED, FAILED, RESULT_UNKNOWN, CANCELED, REJECTED (checks failed, nothing moved)
bool pose_reached              # measured joint positions within tolerance of the goal
string reason_code             # e.g. POSE_NOT_RECORDED, TARGET_TOO_FAR, MOVE_TIMEOUT
string message
string[] joint_names
int32[] final_ticks            # Dynamixel position ticks, 4096 per turn
int32 max_error_ticks
bool simulated                 # true when no real motor moved (--dry-run, --fake-follower)
---
# Feedback
string phase                   # MOVING once motion starts; nothing moves before the first feedback
string[] joint_names
int32[] present_ticks
int32 max_error_ticks
