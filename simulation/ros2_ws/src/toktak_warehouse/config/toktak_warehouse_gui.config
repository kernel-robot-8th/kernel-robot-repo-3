<?xml version="1.0"?>
<gui fullscreen="false">
  <plugin filename="GzScene3D" name="3D View">
    <gz-gui>
      <title>3D View</title>
    </gz-gui>
    <engine>ogre2</engine>
    <scene>scene</scene>
    <ambient_light>0.42 0.45 0.47</ambient_light>
    <background_color>0.22 0.27 0.30</background_color>
    <!-- Elevated view from the open side, aimed into the warehouse interior. -->
    <camera_pose>1.9 1.2 3.7 0 1.42 1.57</camera_pose>
  </plugin>
  <plugin filename="WorldControl" name="World control"/>
  <plugin filename="EntityTree" name="Entity tree"/>
</gui>
