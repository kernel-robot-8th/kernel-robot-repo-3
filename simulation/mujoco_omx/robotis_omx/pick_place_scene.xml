<mujoco model="ROBOTIS OMX table and objects scene">
  <!-- Reuses the pinned ROBOTIS MJCF and original visual/collision meshes. -->
  <include file="omx.xml"/>

  <option timestep="0.002" gravity="0 0 -9.81" integrator="implicitfast"/>
  <statistic center="0.36 0.02 0.24" extent="0.95"/>
  <visual>
    <headlight diffuse="0.7 0.7 0.7" ambient="0.35 0.35 0.35" specular="0.08 0.08 0.08"/>
    <global azimuth="135" elevation="-24" offwidth="1280" offheight="720"/>
  </visual>
  <asset>
    <texture type="skybox" builtin="gradient" rgb1="0.35 0.48 0.62" rgb2="0.03 0.04 0.06" width="512" height="3072"/>
    <texture type="2d" name="pick_place_ground_texture" builtin="checker" rgb1="0.22 0.24 0.26" rgb2="0.13 0.14 0.16" width="256" height="256"/>
    <material name="pick_place_ground" texture="pick_place_ground_texture" texuniform="true" texrepeat="4 4" reflectance="0.06"/>
    <material name="pick_place_table" rgba="0.35 0.37 0.39 1"/>
    <material name="pick_place_cube" rgba="0.85 0.18 0.10 1"/>
    <material name="pick_place_box" rgba="0.12 0.38 0.88 1"/>
  </asset>

  <worldbody>
    <light pos="0.0 -0.4 1.2" dir="0 0.25 -1" directional="true" diffuse="0.9 0.9 0.9"/>
    <geom name="pick_place_floor" type="plane" size="0 0 0.05" material="pick_place_ground" friction="1 0.01 0.001"/>

    <!-- A simple work surface and two dynamic objects; dimensions are illustrative. -->
    <geom name="pick_place_table" type="box" pos="0.54 0.02 0.28" size="0.24 0.25 0.02"
          material="pick_place_table" friction="1.0 0.01 0.001"/>
    <body name="pick_place_cube" pos="0.35 0.00 0.325">
      <freejoint name="pick_place_cube_free"/>
      <geom name="pick_place_cube_geom" type="box" size="0.025 0.025 0.025" mass="0.08"
            material="pick_place_cube" friction="1.2 0.02 0.001" solref="0.01 1"/>
    </body>
    <body name="pick_place_box" pos="0.45 0.09 0.335">
      <freejoint name="pick_place_box_free"/>
      <geom name="pick_place_box_geom" type="box" size="0.035 0.045 0.035" mass="0.12"
            material="pick_place_box" friction="1.2 0.02 0.001" solref="0.01 1"/>
    </body>

    <!-- Fixed synthetic RGB camera; pose is a useful view, not a measured calibration. -->
    <camera name="fixed_camera" pos="0.50 -0.72 0.72"
            xyaxes="1 0 0 0 0.485 0.875" fovy="58" resolution="640 480"/>
  </worldbody>
</mujoco>
