# PC별 관제 설정 예시 (실습 PC 2026-11-12 기준). 관제 서버와 주차 판정 launch가 같이 읽습니다.
#   cp .control-station/control-station.env.example .control-station/control-station.env
#   ./run-control-station.sh  # launcher reads the local file automatically
# control-station.env는 Git에서 제외됩니다. 다른 PC에서는 아래 장치 경로를 그 PC에 맞게 고칩니다.

# ROS: 주차 판정 노드와 관제가 같은 domain을 쓰고, 이 PC 안에서만 통신합니다.
ROS_DOMAIN_ID=87
ROS_AUTOMATIC_DISCOVERY_RANGE=LOCALHOST

# 카메라. HCAM0 두 대는 일련번호가 같아 USB 포트(by-path)로 구분합니다: ls -l /dev/v4l/by-path/
# 천장(탑) 캠은 주차 판정 launch(ceiling_parking.launch.py)가 열고, 관제는 그 토픽을 받습니다.
CONTROL_STATION_CEILING_CAMERA=/dev/v4l/by-path/pci-0000:80:14.0-usb-0:4:1.0-video-index0
CONTROL_STATION_HEAD_CAMERA=ros:/ceiling_camera/image_raw/compressed
CONTROL_STATION_SHELF_CAMERA=/dev/v4l/by-path/pci-0000:80:14.0-usb-0:10:1.0-video-index0
# 좌·우 카메라가 각각 USB 포트 4와 10의 허브에 연결된 구성 예시입니다. 실제 장착과 화면을 확인하세요.
CONTROL_STATION_LEFT_CEILING_CAMERA=/dev/v4l/by-path/pci-0000:80:14.0-usb-0:4.4:1.0-video-index0
CONTROL_STATION_RIGHT_CEILING_CAMERA=/dev/v4l/by-path/pci-0000:80:14.0-usb-0:10.4:1.0-video-index0
CONTROL_STATION_LEFT_JOINT_CAMERA=/dev/v4l/by-path/pci-0000:80:14.0-usb-0:4.3:1.0-video-index0
CONTROL_STATION_RIGHT_JOINT_CAMERA=/dev/v4l/by-path/pci-0000:80:14.0-usb-0:10.3:1.0-video-index0
# 레거시 단일 관절 카메라 입력은 위 좌·우 관절 카메라를 쓰지 않을 때만 사용합니다.
# CONTROL_STATION_JOINT_CAMERA=/dev/v4l/by-id/usb-Innomaker_Innomaker-U20CAM-720P_SN0001-video-index0

# 핑키 주차 판정: .control-station/parking-spots/<spot_id>.json
CONTROL_STATION_PARKING_SPOT=pinky_dock_1

# YOLO: 인웅님 best25 (feat/yolo-object-detection 74b40c0). scripts/check_setup.sh --vision이 받아 둡니다.
CONTROL_STATION_HEAD_YOLO_WEIGHTS=.control-station/models/best25_74b40c0.pt
CONTROL_STATION_SHELF_YOLO_WEIGHTS=.control-station/models/best25_74b40c0.pt
CONTROL_STATION_HEAD_YOLO_DEVICE=cpu
CONTROL_STATION_SHELF_YOLO_DEVICE=cpu

# 정면·상단 일반 검출에 best26을 사용할 경우 위 HEAD 가중치를 교체하고 FRONT 가중치를 설정합니다.
# CONTROL_STATION_HEAD_YOLO_WEIGHTS=yolo/models/best26.pt
# CONTROL_STATION_FRONT_YOLO_WEIGHTS=yolo/models/best26.pt
# 핑키 탑재 보조 모델. 같은 프레임의 일반 YOLO 결과와 합쳐 탑재 목록과 주문 확인에 사용합니다.
# CONTROL_STATION_LOAD_YOLO_WEIGHTS=yolo/models/pinky_cargo_5class_v2.pt
# CONTROL_STATION_LOAD_YOLO_CONF=0.5
# 상단 카메라의 왼쪽 선반 영역 (640×480 영상의 픽셀 좌표)
# CONTROL_STATION_HEAD_SHELF_REGION=20,0,155,480
# CONTROL_STATION_HEAD_MIDDLE_REGION=156,0,365,480
# 재고 표시에 사용할 정면 카메라 영역 (640×480 전체 화면이 기본)
# CONTROL_STATION_FRONT_INVENTORY_REGION=0,0,640,480

# 팔 2대 (docs/implementation/runbook.md "팔 2대 · 카메라 6대"). 팔마다 포트·자세 파일·그리퍼 캠·탑 캠을 따로 줍니다.
# arm-01 = 왼쪽 선반 앞 A9F93543, arm-02 = 오른쪽 선반 앞 F58AE686 (config/arms.json board_serial, 2026-11-16 팔 담당 배치).
# 이름은 CONTROL_STATION_ARM01_*·ARM02_* 또는 CONTROL_STATION_LEFT_*·RIGHT_* 어느 쪽이든 됩니다
# (FOLLOWER_PORT, OMX_POSES, 그리퍼 캠 = GRIPPER_CAMERA 또는 JOINT_CAMERA, 탑 캠 = OVERHEAD_CAMERA 또는 CEILING_CAMERA).
# 워커는 연결된 보드 시리얼을 config/arms.json과, 자세 파일의 follower_board를 포트와 대조해 다르면 움직이지 않습니다.
# 카메라 경로는 꽂은 USB 자리(by-path)로: ls -l /dev/v4l/by-path/  (아래 카메라 경로는 자리 예시라 실제와 다릅니다)
CONTROL_STATION_LEFT_FOLLOWER_PORT=/dev/serial/by-id/usb-ROBOTIS_OpenRB-150_A9F9354350323952582E3120FF070727-if00
CONTROL_STATION_LEFT_OMX_POSES=.control-station/omx-poses-A9F93543.json
CONTROL_STATION_RIGHT_FOLLOWER_PORT=/dev/serial/by-id/usb-ROBOTIS_OpenRB-150_F58AE68650323952582E3120FF05260E-if00
CONTROL_STATION_RIGHT_OMX_POSES=config/omx-slot-poses.json
# CONTROL_STATION_LEFT_JOINT_CAMERA=/dev/v4l/by-path/pci-0000:80:14.0-usb-0:<자리>:1.0-video-index0
# CONTROL_STATION_LEFT_CEILING_CAMERA=/dev/v4l/by-path/pci-0000:80:14.0-usb-0:<자리>:1.0-video-index0
# CONTROL_STATION_RIGHT_JOINT_CAMERA=/dev/v4l/by-path/pci-0000:80:14.0-usb-0:<자리>:1.0-video-index0
# CONTROL_STATION_RIGHT_CEILING_CAMERA=/dev/v4l/by-path/pci-0000:80:14.0-usb-0:<자리>:1.0-video-index0
# CONTROL_STATION_ARM01_ROBOT_ID=omx_follower_arm   LeRobot 보정 파일 이름 (팔마다 따로 보정했다면 다르게)
# 탑 캠도 관제 화면에 띄우려면(USB 대역을 더 씀): CONTROL_STATION_OVERHEAD_CAMERA_PREVIEW=1

# 팔 1대(예전 설정, arm-01 호환). 자세 파일은 follower 보드마다 따로입니다 (omx-poses-<보드 앞 8자리>.json).
CONTROL_STATION_FOLLOWER_PORT=/dev/serial/by-id/usb-ROBOTIS_OpenRB-150_A9F9354350323952582E3120FF070727-if00
CONTROL_STATION_OMX_POSES=.control-station/omx-poses-A9F93543.json
# 작업의 EXECUTE_ARM_TASK가 실제 팔 명령을 큐에 넣게 하려면 1. 팔이 연결된 PC에서만 켭니다.
# CONTROL_STATION_TASK_REAL_ARM=1

# 주문 흐름 (기본은 모의 세계)
# CONTROL_STATION_ORDER_COUNTS=camera                      선반 재고·핑키 위 개수를 카메라 YOLO로 셈
# CONTROL_STATION_PINKY_FLEET_URL=http://127.0.0.1:8765    핑키 관제(pinky_fleet_dashboard)와 연동

# run-control-station.sh starts the LeRobot policy server and configured real arm workers when missing.
# Set to 0 to run only the control station.
CONTROL_STATION_AUTO_START_ARM_RUNTIME=1
# Optional override; defaults to ~/Desktop/lerobot/venv/bin/python.
# CONTROL_STATION_LEROBOT_PYTHON=/path/to/lerobot/venv/bin/python
# ACT server defaults: 127.0.0.1:8080, 30 fps, 33 ms inference latency, 1 s observation queue timeout.
# CONTROL_STATION_POLICY_SERVER_HOST=127.0.0.1
# CONTROL_STATION_POLICY_SERVER_PORT=8080
# CONTROL_STATION_POLICY_FPS=30
# CONTROL_STATION_POLICY_INFERENCE_LATENCY=0.033
# CONTROL_STATION_POLICY_OBS_QUEUE_TIMEOUT=1
# Slow profile applied to manual moves; policy commands use the learned action profile.
CONTROL_STATION_OMX_PROFILE_VELOCITY=2
CONTROL_STATION_OMX_PROFILE_ACCELERATION=1
# All arm joints may be this many ticks from recorded home for a policy return to count as confirmed.
CONTROL_STATION_POLICY_REST_TICKS=200
